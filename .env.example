# 应用信息
PROJECT_NAME=图片管理系统
PROJECT_DESCRIPTION=图片管理与轨迹记录系统
PROJECT_VERSION=1.0.0

# 环境设置
ENVIRONMENT=development

# 数据库设置
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=tp

# 安全设置
# SECRET_KEY 现在由 KeyManager 自动管理，无需手动设置
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理员账户设置
ADMIN_USERNAME=admin
ADMIN_COMPANY=your_company
ADMIN_PHONE=your_phone
ADMIN_PASSWORD=Admin@123  # 密码须符合安全要求

# 服务器设置
HOST=0.0.0.0
PORT=8000

# CORS配置
# 开发环境下自动允许所有来源
CORS_ORIGINS=["*"]

# 日志设置
LOG_DIR=logs
LOG_FILE=logs/app.log
LOG_LEVEL=INFO

# 文件上传设置
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif

# 应用配置
APP_DEBUG=True

# 离线地图配置
MAP_TILE_PATH=frontend/static/js/MAP_zxy
MAP_DEFAULT_ZOOM=11
MAP_MAX_ZOOM=12

# 注意事项：
# 1. 此文件仅作为模板，实际使用时复制为 .env 并修改相应值
# 2. 生产环境必须修改所有密码和敏感信息
# 3. 确保 .env 文件不会被提交到版本控制系统
# 4. 密钥轮换由系统自动管理，详见 key_management_readme.md
# 5. 确保文件存储目录具有适当的访问权限

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=tp

# 应用配置
APP_SECRET_KEY=your_secret_key
APP_HOST=0.0.0.0
APP_PORT=8000

# 文件上传配置
UPLOAD_FOLDER=uploads

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 离线地图配置
MAP_TILE_PATH=frontend/static/js/MAP_zxy
MAP_DEFAULT_ZOOM=11
MAP_MAX_ZOOM=12 