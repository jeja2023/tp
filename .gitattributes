# 设置默认行为，防止文本和换行符出现问题
* text=auto eol=lf

# 声明文件编码
*.py text encoding=utf-8
*.html text encoding=utf-8
*.css text encoding=utf-8
*.js text encoding=utf-8
*.json text encoding=utf-8
*.md text encoding=utf-8
*.txt text encoding=utf-8
*.ini text encoding=utf-8
*.env text encoding=utf-8
*.sql text encoding=utf-8

# 二进制文件不应该被修改
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# 指定语言的文件类型
*.py linguist-language=Python
*.html linguist-language=HTML
*.js linguist-language=JavaScript
*.css linguist-language=CSS 